DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=sqlite+aiosqlite:///./freshsales_capi.db
META_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
META_PAGE_ACCESS_TOKEN=replace-with-page-token
META_PIXEL_ID=replace-with-pixel-or-dataset-id
META_CAPI_ACCESS_TOKEN=replace-with-capi-access-token
META_DATASET_ID=replace-with-capi-dataset-id
FRESHSALES_DOMAIN=https://yourdomain.myfreshworks.com
FRESHSALES_API_KEY=replace-with-freshsales-api-key
FRESHSALES_WEBHOOK_SECRET=replace-with-shared-webhook-secret
FRESHSALES_META_LEAD_FIELD=cf_meta_lead_id
FRESHSALES_CAMPAIGN_NAME_FIELD=cf_campaign_name
FRESHSALES_CAMPAIGN_ID_FIELD=cf_campaign_id
FRESHSALES_AD_SET_FIELD=cf_ad_set
FRESHSALES_AD_NAME_FIELD=cf_ad_name
META_GRAPH_VERSION=v20.0
LEAD_REPLAY_INTERVAL_SECONDS=300
LEAD_REPLAY_MAX_AGE_HOURS=48
LEAD_MAX_CONCURRENCY=10
SLACK_WEBHOOK_URL=
ALERT_CHANNEL=slack
MAX_HTTP_ATTEMPTS=3
MATCH_RETRY_ATTEMPTS=3
MATCH_RETRY_MIN_SECONDS=5
MATCH_RETRY_MAX_SECONDS=10
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
DEBUG_LOG_PII=false
